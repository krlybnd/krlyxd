# SERVER ONLY. Copy to studio/.env and supply values locally; never commit .env.
# Typed CAD review: explicit local CLI ports and persistent accepted history.
# KRLYSCI_BIN=/absolute/path/to/krlysci
# KRLY3D_CAD_BIN=/absolute/path/to/krly3d-cad-check
# STUDIO_CAD_DIR=/absolute/path/to/local/cad-history
# An existing OpenAI-compatible LiteLLM endpoint can be used without this profile.
# Include any gateway path prefix and optional /v1. Do not use /bedrock passthrough.
LITELLM_BASE_URL=http://127.0.0.1:4010/v1
# A gateway virtual key authorized for the selected aliases. Not an upstream key.
LITELLM_API_KEY=
LITELLM_CHAT_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# Explicit opt-ins: leave blank when a route or its credentials are unavailable.
LITELLM_VISION_MODEL=
LITELLM_SPEECH_MODEL=
LITELLM_EMBEDDING_MODEL=
# Explicit web-search opt-in through the same authenticated LiteLLM /responses.
# The selected alias must support web_search and max_tool_calls. Blank falls back
# to LITELLM_CHAT_MODEL only when research is enabled; this does not provision it.
STUDIO_RESEARCH_ENABLED=false
LITELLM_RESEARCH_MODEL=
# Optional operator-verified USD tariffs by exact alias; default cost is unknown
# without x-litellm-response-cost. Never infer tariffs from alias names.
# JSON: {"alias":{"verified":true,"inputUsdPerMillion":2,"outputUsdPerMillion":8,"cachedInputUsdPerMillion":0.5}}
# Example numbers above illustrate syntax, NOT verified prices. Research totals
# are never estimated from token tariffs because search charges may be separate.
LITELLM_USAGE_RATES_JSON=
LITELLM_TIMEOUT_MS=45000
LITELLM_SPEECH_TIMEOUT_MS=30000
# Legacy aliases use language. For gpt-transcribe aliases set languages;
# none omits the hint when the gateway injects it. No model-name guessing/retries.
LITELLM_SPEECH_LANGUAGE_FIELD=language

# Server-side speech selection. auto: Azure when its key is set, then Chromium
# when its explicit key is set, otherwise LiteLLM. Set one provider to pin it.
STUDIO_SPEECH_PROVIDER=auto
STUDIO_SPEECH_LANGUAGE=hu-HU
STUDIO_SPEECH_TIMEOUT_MS=30000
# Working reference laptop compatibility path. Supply the client key privately;
# it is intentionally absent from this repository. Requires installed ffmpeg.
CHROMIUM_SPEECH_KEY=
# Azure Speech subscription credentials (not Azure OpenAI). Also needs ffmpeg.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral

# OPTIONAL PROXY PROCESS ONLY, for config/litellm.yaml. No keys in browser env.
# Set a new master key locally. Do not reuse another project's master key.
LITELLM_MASTER_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
# Bedrock uses the proxy's AWS credential chain/IAM role and model access.
# AWS_PROFILE=your-local-profile
# AWS_REGION_NAME=eu-central-1

# Example opt-ins after provisioning the corresponding routes:
# LITELLM_VISION_MODEL=eu.anthropic.claude-sonnet-4-6
# LITELLM_SPEECH_MODEL=speech-to-text
# LITELLM_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
