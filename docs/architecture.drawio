<mxfile host="app.diagrams.net"><diagram id="layers" name="Layers and patterns"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="layers-1" value="&lt;b&gt;Clients&lt;/b&gt;&lt;br&gt;AI agent (MCP) · game editor · CAD UI · tests · model files (models/*.k3d)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/></mxCell><mxCell id="layers-2" value="cli &amp;#8212; assembles the packages; one Endpoint per kernel" style="swimlane;startSize=30;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontColor=#1B1F24;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1200" height="140" as="geometry"/></mxCell><mxCell id="layers-3" value="&lt;b&gt;Session / Endpoint&lt;/b&gt;&lt;br&gt;the kernel's one door; krlyvis is another&lt;br&gt;&lt;font color=&quot;#6B4FBB&quot;&gt;&lt;i&gt;Facade&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-2"><mxGeometry x="20" y="45" width="275" height="80" as="geometry"/></mxCell><mxCell id="layers-4" value="&lt;b&gt;rpc&lt;/b&gt;&lt;br&gt;JSON-RPC 2.0, one request per line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-2"><mxGeometry x="315" y="45" width="275" height="80" as="geometry"/></mxCell><mxCell id="layers-5" value='&lt;b&gt;dialect&lt;/b&gt;&lt;br&gt;plain · mcp&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Adapter&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-2"><mxGeometry x="610" y="45" width="275" height="80" as="geometry"/></mxCell><mxCell id="layers-6" value='&lt;b&gt;peer&lt;/b&gt;&lt;br&gt;--peer vis=krlyvis: methods as vis.…&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Proxy&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-2"><mxGeometry x="905" y="45" width="275" height="80" as="geometry"/></mxCell><mxCell id="layers-7" value="plugin packages &amp;#8212; each registers itself into the builder; the kernel knows none of them" style="swimlane;startSize=30;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontColor=#1B1F24;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="1200" height="170" as="geometry"/></mxCell><mxCell id="layers-8" value='&lt;b&gt;std&lt;/b&gt;&lt;br&gt;modelling: curves, surfaces, tools, sections, booleans, blends, loft&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Strategy&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-7"><mxGeometry x="20" y="45" width="220" height="100" as="geometry"/></mxCell><mxCell id="layers-9" value='&lt;b&gt;view&lt;/b&gt;&lt;br&gt;camera, raycast and sphere-trace render, silhouette, pick&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Plugin package&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-7"><mxGeometry x="260" y="45" width="220" height="100" as="geometry"/></mxCell><mxCell id="layers-10" value='&lt;b&gt;game&lt;/b&gt;&lt;br&gt;LOD, UV, normals, materials, baking&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Plugin package&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-7"><mxGeometry x="500" y="45" width="220" height="100" as="geometry"/></mxCell><mxCell id="layers-11" value='&lt;b&gt;exchange&lt;/b&gt;&lt;br&gt;STEP, STL, OBJ, glTF&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Adapter&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-7"><mxGeometry x="740" y="45" width="220" height="100" as="geometry"/></mxCell><mxCell id="layers-12" value='&lt;b&gt;fluid&lt;/b&gt;&lt;br&gt;MAC grid, advection, pressure, level set&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Plugin package&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-7"><mxGeometry x="980" y="45" width="220" height="100" as="geometry"/></mxCell><mxCell id="layers-13" value="kernel &amp;#8212; contracts and orchestration, zero implementations" style="swimlane;startSize=30;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontColor=#1B1F24;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1200" height="360" as="geometry"/></mxCell><mxCell id="layers-14" value='&lt;b&gt;Shape &amp;#8212; the foundation&lt;/b&gt;&lt;br&gt;implicit distance + boundary; B-rep, field and SubD leaves, operators&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Composite · Interpreter&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-13"><mxGeometry x="20" y="45" width="280" height="80" as="geometry"/></mxCell><mxCell id="layers-15" value='&lt;b&gt;interpret&lt;/b&gt;&lt;br&gt;brep · mesh · field · levelset: one generic plugin each&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Strategy · Chain&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-13"><mxGeometry x="320" y="45" width="280" height="80" as="geometry"/></mxCell><mxCell id="layers-16" value='&lt;b&gt;Kernel / Session&lt;/b&gt;&lt;br&gt;apply(op) · ask(query)&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Facade · CQRS&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-13"><mxGeometry x="620" y="45" width="280" height="80" as="geometry"/></mxCell><mxCell id="layers-17" value='&lt;b&gt;Model&lt;/b&gt;&lt;br&gt;Document &amp;#8594; Shapes, interpretations memoised per node&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Memoised pure function&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-13"><mxGeometry x="920" y="45" width="280" height="80" as="geometry"/></mxCell><mxCell id="layers-18" value='&lt;b&gt;ports/&amp;lt;family&amp;gt;&lt;/b&gt;&lt;br&gt;trait + Request + Response + contract test&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Ports &amp;amp; Adapters&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-13"><mxGeometry x="20" y="145" width="280" height="80" as="geometry"/></mxCell><mxCell id="layers-19" value='&lt;b&gt;pipeline&lt;/b&gt;&lt;br&gt;node stages · edit stages&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Pipes &amp;amp; Filters&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-13"><mxGeometry x="320" y="145" width="280" height="80" as="geometry"/></mxCell><mxCell id="layers-20" value='&lt;b&gt;topo · mesh · field&lt;/b&gt;&lt;br&gt;the data of the three interpretations&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Visitor&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-13"><mxGeometry x="620" y="145" width="280" height="80" as="geometry"/></mxCell><mxCell id="layers-21" value='&lt;b&gt;answers&lt;/b&gt;&lt;br&gt;Reply · predicates · exactness marks&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Specification&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-13"><mxGeometry x="920" y="145" width="280" height="80" as="geometry"/></mxCell><mxCell id="layers-22" value="core &amp;#8212; shared by every kernel (krly3d, krlyvis); no geometry knowledge beyond math" style="swimlane;startSize=30;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontColor=#1B1F24;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="1200" height="240" as="geometry"/></mxCell><mxCell id="layers-23" value='&lt;b&gt;plugin&lt;/b&gt;&lt;br&gt;Family&amp;lt;Context&amp;gt; · Plugin · Registry &amp;#8212; the one mould&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Registry&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-22"><mxGeometry x="20" y="45" width="280" height="80" as="geometry"/></mxCell><mxCell id="layers-24" value="&lt;b&gt;schema&lt;/b&gt;&lt;br&gt;Value · Params · Schema &amp;#8212; the protocol" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-22"><mxGeometry x="320" y="45" width="280" height="80" as="geometry"/></mxCell><mxCell id="layers-25" value='&lt;b&gt;Attempt&amp;lt;T&amp;gt;&lt;/b&gt;&lt;br&gt;Done · Declined · Failed&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;Chain of Responsibility&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-22"><mxGeometry x="620" y="45" width="280" height="80" as="geometry"/></mxCell><mxCell id="layers-26" value="&lt;b&gt;Accuracy · Exactness&lt;/b&gt;&lt;br&gt;tolerances; = exact · ~ numeric · ? sampled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-22"><mxGeometry x="920" y="45" width="280" height="80" as="geometry"/></mxCell><mxCell id="layers-27" value="&lt;b&gt;math&lt;/b&gt;&lt;br&gt;frames, roots, quadrics, elliptic, NURBS, quadrature, sparse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-22"><mxGeometry x="20" y="145" width="280" height="80" as="geometry"/></mxCell><mxCell id="layers-28" value="&lt;b&gt;Id · Error · Clock&lt;/b&gt;&lt;br&gt;stable ids, one error type, injected time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="layers-22"><mxGeometry x="320" y="145" width="280" height="80" as="geometry"/></mxCell><mxCell id="layers-29" value="JSON-RPC 2.0 / MCP over stdio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="layers-1" target="layers-2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layers-30" value="register(builder)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="layers-2" target="layers-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layers-31" value="implement ports" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="layers-7" target="layers-13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layers-32" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="layers-13" target="layers-22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="layers-33" value='&lt;font color="#6B4FBB"&gt;&lt;i&gt;italic purple&lt;/i&gt;&lt;/font&gt; = design pattern.&lt;br&gt;Dependencies point downward only;&lt;br&gt;the compiler enforces it through crate dependencies.' style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1280" y="130" width="260" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="foundation" name="One foundation, many interpretations"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="foundation-1" value='&lt;b&gt;tools&lt;/b&gt;&lt;br&gt;each defines its geometry once: extrude, loft (NURBS), blend, sculpt, subd …&lt;br&gt;&lt;font color="#6B4FBB"&gt;&lt;i&gt;one operation, one definition&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="360" height="80" as="geometry"/></mxCell><mxCell id="foundation-2" value="Shape &amp;#8212; the node result (Composite)" style="swimlane;startSize=30;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontColor=#1B1F24;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="460" y="20" width="520" height="250" as="geometry"/></mxCell><mxCell id="foundation-3" value="&lt;b&gt;brep leaf&lt;/b&gt;&lt;br&gt;exact B-rep body" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="foundation-2"><mxGeometry x="20" y="45" width="230" height="80" as="geometry"/></mxCell><mxCell id="foundation-4" value="&lt;b&gt;field leaf&lt;/b&gt;&lt;br&gt;sparse voxel grid: scans, sculpting, fluids" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="foundation-2"><mxGeometry x="270" y="45" width="230" height="80" as="geometry"/></mxCell><mxCell id="foundation-5" value="&lt;b&gt;subd leaf&lt;/b&gt;&lt;br&gt;Catmull&amp;#8211;Clark cage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="foundation-2"><mxGeometry x="20" y="145" width="230" height="80" as="geometry"/></mxCell><mxCell id="foundation-6" value="&lt;b&gt;operators&lt;/b&gt;&lt;br&gt;union/subtract/intersect · blend · offset · shell · transform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="foundation-2"><mxGeometry x="270" y="145" width="230" height="80" as="geometry"/></mxCell><mxCell id="foundation-7" value="make" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="foundation-1" target="foundation-2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="foundation-8" value="interpret &amp;#8212; one generic plugin per reading (Strategy, Chain: exact &amp;#8594; numeric &amp;#8594; sampled)" style="swimlane;startSize=30;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontColor=#1B1F24;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="940" height="150" as="geometry"/></mxCell><mxCell id="foundation-9" value="&lt;b&gt;brep&lt;/b&gt;&lt;br&gt;Shape &amp;#8594; Body; exact where leaves are analytic, else fitted ~" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="foundation-8"><mxGeometry x="20" y="50" width="210" height="80" as="geometry"/></mxCell><mxCell id="foundation-10" value="&lt;b&gt;mesh&lt;/b&gt;&lt;br&gt;Shape &amp;#8594; Mesh; tessellation · subdivision · dual contouring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="foundation-8"><mxGeometry x="250" y="50" width="210" height="80" as="geometry"/></mxCell><mxCell id="foundation-11" value="&lt;b&gt;field&lt;/b&gt;&lt;br&gt;Shape &amp;#8594; sparse grid from distance()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="foundation-8"><mxGeometry x="480" y="50" width="210" height="80" as="geometry"/></mxCell><mxCell id="foundation-12" value="&lt;b&gt;levelset&lt;/b&gt;&lt;br&gt;field + velocity &amp;#8594; field over time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="foundation-8"><mxGeometry x="710" y="50" width="210" height="80" as="geometry"/></mxCell><mxCell id="foundation-13" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="foundation-2" target="foundation-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="foundation-14" value="&lt;b&gt;CAD&lt;/b&gt;&lt;br&gt;STEP AP242, measures, PMI" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="220" height="70" as="geometry"/></mxCell><mxCell id="foundation-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="foundation-9" target="foundation-14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="foundation-16" value="&lt;b&gt;game&lt;/b&gt;&lt;br&gt;glTF, LOD, UV, baking" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="280" y="560" width="220" height="70" as="geometry"/></mxCell><mxCell id="foundation-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="foundation-10" target="foundation-16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="foundation-18" value="&lt;b&gt;view&lt;/b&gt;&lt;br&gt;render, silhouette, pick" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="520" y="560" width="220" height="70" as="geometry"/></mxCell><mxCell id="foundation-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="foundation-11" target="foundation-18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="foundation-20" value="&lt;b&gt;fluid&lt;/b&gt;&lt;br&gt;simulation steps" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="760" y="560" width="220" height="70" as="geometry"/></mxCell><mxCell id="foundation-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="foundation-12" target="foundation-20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="foundation-22" value="A loft is a NURBS surface once. The CAD reading wraps it in topology,&lt;br&gt;the game reading tessellates the same surface, the field reading&lt;br&gt;measures distance to it. No tool has a second, game-side version." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1020" y="40" width="380" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flow" name="Request flow"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="flow-1" value="&lt;b&gt;apply(op, dry?, expect?)&lt;/b&gt;" style="rounded=1